# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Default model. Format: provider/model
MINI_DSH_MODEL=deepseek/deepseek-v4-flash

# Per-run governance. Use null to disable an individual limit.
MINI_DSH_MAX_STEPS=32
MINI_DSH_MAX_TOOL_CALLS=64
MINI_DSH_MAX_DURATION_MS=600000
MINI_DSH_MAX_INPUT_TOKENS=null
MINI_DSH_MAX_OUTPUT_TOKENS=null
MINI_DSH_MAX_COST=null
MINI_DSH_MAX_TOOL_FAILURES=3

# Deterministic progress heuristic. Off preserves existing Agent behavior.
MINI_DSH_PROGRESS_MODE=off
MINI_DSH_PROGRESS_SOFT_STEPS=3
MINI_DSH_PROGRESS_HARD_STEPS=6

# Per-request model context pressure. This is independent from run token budgets above.
# Leave max context tokens empty or null to disable pressure measurement thresholds.
MINI_DSH_MAX_CONTEXT_TOKENS=null
# Defaults to 4096 when max context tokens is enabled and this is unset.
MINI_DSH_RESERVED_OUTPUT_TOKENS=
MINI_DSH_COMPACT_AT_RATIO=0.8

# Maximum concurrency for tools explicitly marked concurrencySafe=true.
MINI_DSH_MAX_PARALLEL_TOOL_CALLS=4

# Tool visibility defaults to all for compatibility; deterministic and progressive routing are opt-in.
MINI_DSH_TOOL_ROUTING=all
MINI_DSH_MAX_VISIBLE_TOOLS=12
# Progressive mode only: max distinct Tools activated per Run by tool_search.
MINI_DSH_MAX_ACTIVATED_TOOLS=24

# Optional provider/model-independent pricing JSON. Example:
# {"deepseek/deepseek-v4-flash":{"inputPer1k":0.0001,"outputPer1k":0.0004}}
MINI_DSH_PRICING_JSON=

# Directory the agent works in; defaults to the process cwd.
# MINI_DSH_WORKSPACE=/absolute/path/to/project

# Optional Context7 MCP key. The host still starts if mcp.context7.com is unreachable.
# CONTEXT7_API_KEY=
