{
    "name": "mini-dsh",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "A minimal handwritten runtime following DSH concepts",
    "engines": {
        "node": ">=20.18.1"
    },
    "packageManager": "pnpm@11.22.0",
    "scripts": {
        "start": "node src/index.js",
        "test": "node --test test/*.test.js",
        "check": "node scripts/check-syntax.js",
        "lint": "biome check .",
        "eval:tool-routing": "node scripts/eval-tool-routing.js",
        "eval:progress": "node scripts/eval-progress.js",
        "eval:context-pressure": "node scripts/eval-context-pressure.js",
        "eval:long-horizon": "node scripts/eval-long-horizon.js",
        "eval:fault-injection": "node scripts/eval-fault-injection.js",
        "eval:crash-recovery": "node scripts/eval-crash-recovery.js",
        "lint:fix": "biome check --write .",
        "format": "biome format --write ."
    },
    "keywords": [
        "dsh"
    ],
    "author": "junsen",
    "license": "MIT",
    "dependencies": {
        "@deepseek-ai/cordis": "^4.0.1",
        "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2",
        "ajv": "^8.20.0",
        "dotenv": "^17.4.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10"
    }
}
